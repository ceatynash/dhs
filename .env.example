# DHS independent authentication (set these in Render's environment settings)
PORT=3000
DHS_DEVELOPER_NAME=DHS Portal Administrator
DHS_DEVELOPER_PIN=replace-with-a-private-random-16-character-or-longer-value
# Generate a long random value for session-related signing if enabled.
SESSION_SECRET=replace-with-a-long-random-secret
# Optional: restrict browser origins when deploying behind a known domain.
# ALLOWED_ORIGIN=https://your-domain.example

# Optional OpenAI-compatible AI provider. Keep the API key ONLY in Render Environment, never commit it.
# OpenAI example: OPENAI_BASE_URL=https://api.openai.com/v1
# Groq example: OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Set OPENAI_MODEL to a model enabled by your chosen provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Copy the Internal Database URL from Render's Connect panel; never commit the real URL.
DATABASE_URL=postgresql://set-in-render-dashboard
