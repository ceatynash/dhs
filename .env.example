# Copy these values into your deployment environment (do not commit real secrets).
PORT=3000
DEVELOPER_EMAIL=your-admin-email@example.com
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
# Optional: restrict browser origins when deploying behind a known domain.
# ALLOWED_ORIGIN=https://your-domain.example
# Generate a long random value for session-related signing if enabled.
SESSION_SECRET=replace-with-a-long-random-secret
